get_git_branch() {
    # return previous exit status
    ps=$?

    # ensure git exists and we're inside a repo
    command -v git >/dev/null 2>&1 || return "$ps"
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return "$ps"

    # get branch or fallback to short hash
    branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)
    if [[ -z $branch ]]; then
        branch=$(git rev-parse --short HEAD 2>/dev/null) || return "$ps"
    fi

    # dirty check: unstaged, staged, then first untracked file only
    if ! git diff --quiet --ignore-submodules 2>/dev/null ||
        ! git diff --cached --quiet --ignore-submodules 2>/dev/null ||
        [ -n "$(git ls-files --others --exclude-standard --directory --no-empty-directory | head -n1)" ]; then
        printf '<%s*>' "$branch"
    else
        printf '<%s>' "$branch"
    fi

    return "$ps"
}

__build_prompt() {
    local exit_code=$?
    local branch_str
    local symbol="\$"

    branch_str="$(get_git_branch)"

    if [[ $exit_code -ne 0 ]]; then
        symbol="\[${orange}\]\$\[${reset}\]"
    fi

    PS1="\w${branch_str}\[${reset}\]${symbol}\[${reset}\] "
}

PROMPT_COMMAND=__build_prompt

# PS1 is fully built above; never re-expand it, or a branch named
# '$(cmd)' would execute cmd on every prompt
shopt -u promptvars
